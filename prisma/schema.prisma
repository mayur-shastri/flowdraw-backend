// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String?
  supabaseId     String?         @unique
  phone          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  diagrams       Diagram[]       @relation("Owner")
  collaborations Collaboration[] @relation("UserCollaborations")
}

model Diagram {
  id            String          @id @default(cuid())
  title         String
  userId        String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  elements      Json
  connections   Json
  version       Int             @default(1)
  user          User            @relation("Owner", fields: [userId], references: [id])
  collaborators Collaboration[] @relation("DiagramCollaborations")
}

model Collaboration {
  userId      String
  diagramId   String
  user        User        @relation("UserCollaborations", fields: [userId], references: [id], onDelete: Cascade)
  diagram     Diagram     @relation("DiagramCollaborations", fields: [diagramId], references: [id], onDelete: Cascade)
  accessLevel AccessLevel

  @@id([userId, diagramId])
}

model CollabInvitation {
  id          String      @id @default(cuid())
  ownerId     String
  diagramId   String
  userId      String
  accessLevel AccessLevel @default(VIEW)
  createdAt   DateTime    @default(now())
  status      Status      @default(PENDING)
}

enum AccessLevel {
  VIEW
  EDIT
}

enum Status {
  PENDING
  ACCEPTED
  REJECTED
}